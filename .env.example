# ─── Base de données ───────────────────────────────────────
# PostgreSQL — identifiants à ne JAMAIS committer
DATABASE_URL=postgresql://user:password@localhost:5432/haivoly
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
# Journalisation SQL (dev uniquement)
TYPEORM_LOGGING=false
# Très déconseillé : synchronisation automatique du schéma (jamais en prod)
DB_SYNCHRONIZE=false

# ─── Authentification ──────────────────────────────────────
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Serveur ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Liste d'origines séparées par des virgules (vide = toutes)
CORS_ORIGINS=

# ─── Emails (vérification d'adresse + mot de passe oublié) ──
# Aucun secret SMTP ne doit être commité.
APP_NAME=Haivoly
# URL de l'interface web qui reçoit les liens (verify-email / reset-password)
FRONTEND_URL=http://localhost:5173
# Laisser SMTP_HOST vide en développement : le lien est alors journalisé.
# En production, SMTP_HOST est OBLIGATOIRE (sinon l'envoi échoue explicitement).
SMTP_HOST=
# 587 = STARTTLS, 465 = SMTP implicite TLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Haivoly <noreply@haivoly.mg>

# ─── Politique e-mail ──────────────────────────────────────
# Refuser les fournisseurs jetables à l'inscription (true/false).
# Le critère est le caractère TEMPORAIRE du service, pas sa gratuité :
# gmail.com, yahoo.fr ou moov.mg restent acceptés.
EMAIL_BLOQUER_JETABLES=true
# Domaines jetables à ajouter, séparés par des virgules (sans modifier le code)
EMAIL_DOMAINES_JETABLES_SUPPLEMENTAIRES=
# Domaines à retirer de la liste jetable (échappatoire documentée)
EMAIL_DOMAINES_JETABLES_IGNORES=
# Exiger une adresse confirmée avant l'accès aux endpoints protégés.
# Mettre à false uniquement pour un environnement de test jetable.
EMAIL_VERIFICATION_REQUISE=true
